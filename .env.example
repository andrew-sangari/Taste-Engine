# Hosted Spotify and refresh administration. Never commit real values.
TASTE_ENGINE_ENV=local
SPOTIFY_CLIENT_ID=
SPOTIFY_TOKEN_ENCRYPTION_KEY=
# Local/test escape hatch only. Hosted environments must use encryption.
TASTE_ALLOW_PLAINTEXT_SPOTIFY_TOKENS=0
TASTE_REFRESH_SECRET=
TASTE_LEGACY_PROFILE_EMAIL=
TASTE_ALLOWED_PROFILE_EMAILS=

# Obtain a SeatGeek client ID from its developer portal. Do not commit the real value.
SEATGEEK_CLIENT_ID=
SEATGEEK_APP_SECRET=

# Optional. Missing keys omit that source while the rest of the site still refreshes.
TICKETMASTER_API_KEY=
LASTFM_API_KEY=
TMDB_ACCESS_TOKEN=
# Alternative to TMDB_ACCESS_TOKEN:
TMDB_API_KEY=

# Optional local source-safe editorial layer. Deterministic output remains the fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:26b-mlx
OLLAMA_TIMEOUT_MS=180000
EDMTRAIN_CLIENT_KEY=

# Sites-only private configuration, serialized from brief.json, movies.json,
# sports.json, and personal-context.json by the deployment workflow.
TASTE_ENGINE_CONFIG_JSON=

# Optional deterministic release overrides. Deployment normally derives the Git SHA.
TASTE_ENGINE_RELEASE=
TASTE_ENGINE_COMMIT_SHA=
SOURCE_DATE_EPOCH=
