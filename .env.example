# Hosted Spotify and refresh administration. Never commit real values.
TASTE_ENGINE_ENV=local
SPOTIFY_CLIENT_ID=
SPOTIFY_TOKEN_ENCRYPTION_KEY=
# Local/test escape hatch only. Hosted environments must use encryption.
TASTE_ALLOW_PLAINTEXT_SPOTIFY_TOKENS=0
TASTE_REFRESH_SECRET=
TASTE_LEGACY_PROFILE_EMAIL=
TASTE_ALLOWED_PROFILE_EMAILS=

# Obtain a SeatGeek client ID from its developer portal. Do not commit the real value.
SEATGEEK_CLIENT_ID=
SEATGEEK_APP_SECRET=

# Optional. Missing keys omit that source while the rest of the site still refreshes.
TICKETMASTER_API_KEY=
LASTFM_API_KEY=
TMDB_ACCESS_TOKEN=
# Alternative to TMDB_ACCESS_TOKEN:
TMDB_API_KEY=

# Optional local source-safe editorial layer. Deterministic output remains the fallback.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gemma4:26b-mlx
OLLAMA_TIMEOUT_MS=180000
EDMTRAIN_CLIENT_KEY=

# Optional card enrichment (System One / Jev decision inference). Music and
# Overview cards gain source-linked "About this night" claims when a permitted
# provider publishes enough event detail. With no explicit provider, a TypeSafe
# key selects the direct route and an AI Gateway key the gateway route. Absent
# both, cards render unchanged and jev-events source health reads
# "not configured". Production: set TYPESAFE_AI_API_KEY as a Sites secret.
# See docs/system-one-inference.md.
NIGHTLIFE_INFERENCE_PROVIDER=
TYPESAFE_AI_API_KEY=
TYPESAFE_AI_MODEL=jev-latest
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=typesafe-ai/jev
# Bounds on one refresh's enrichment pass. NIGHTLIFE_MAX_COST_USD catches a
# runaway loop rather than rationing normal use: one candidate costs about
# $0.00004, and a full 24-candidate pass well under a tenth of a cent.
NIGHTLIFE_MAX_CANDIDATES=24
NIGHTLIFE_CONCURRENCY=4
NIGHTLIFE_DEADLINE_MS=60000
NIGHTLIFE_MAX_COST_USD=

# Sites-only private configuration, serialized from brief.json, movies.json,
# sports.json, and personal-context.json by the deployment workflow.
TASTE_ENGINE_CONFIG_JSON=

# Optional deterministic release overrides. Deployment normally derives the Git SHA.
TASTE_ENGINE_RELEASE=
TASTE_ENGINE_COMMIT_SHA=
SOURCE_DATE_EPOCH=
