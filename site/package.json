{
  "name": "taste-engine-site",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "prebuild": "node build/build-deterministic-engine.mjs",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run build && node --test tests/rendered-html.test.mjs tests/release-metadata.test.mjs && node --experimental-strip-types --test tests/date-aware.test.mjs tests/ics.test.mjs tests/feedback-store.test.mjs tests/health-route.test.mjs tests/hosted-refresh.test.mjs tests/hosted-projection.test.mjs tests/migration.test.mjs tests/profile-isolation.test.mjs tests/scheduler.test.mjs tests/token-crypto.test.mjs tests/nightlife.test.mjs",
    "test:browser": "node tests/run-browser-qa.mjs full",
    "test:browser:empty": "node tests/run-browser-qa.mjs empty",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "smoke:build": "node tests/deployment-smoke.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run smoke:build",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.28.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
