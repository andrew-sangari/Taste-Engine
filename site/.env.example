# Hosted values belong in the Vercel project's environment variables. Keep real values out of this file.
TASTE_ENGINE_ENV=local

# Postgres. Leave unset locally: the site then uses an in-process database at site/.pglite/.
DATABASE_URL=
# Supabase is used only to verify sign-in. Leave unset locally.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Local development and tests only: act as this address without signing in.
TASTE_DEV_USER_EMAIL=
# Vercel Cron's bearer secret (24+ characters).
CRON_SECRET=

SPOTIFY_CLIENT_ID=
SPOTIFY_TOKEN_ENCRYPTION_KEY=
TASTE_ALLOW_PLAINTEXT_SPOTIFY_TOKENS=0
TASTE_REFRESH_SECRET=
TASTE_LEGACY_PROFILE_EMAIL=
TASTE_ALLOWED_PROFILE_EMAILS=
LASTFM_API_KEY=
SEATGEEK_CLIENT_ID=
TICKETMASTER_API_KEY=
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
EDMTRAIN_CLIENT_KEY=
OLLAMA_BASE_URL=https://ollama.com/api
OLLAMA_API_KEY=
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=180000

# Required by hosted refresh. Version 2 maps private ranking inputs by profile id.
TASTE_ENGINE_CONFIG_JSON=

# Optional deterministic release overrides. The build otherwise uses package version + Git SHA.
TASTE_ENGINE_RELEASE=
TASTE_ENGINE_COMMIT_SHA=
SOURCE_DATE_EPOCH=
